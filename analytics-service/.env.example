# ── PostgreSQL (used by docker-compose services) ──────────────────────────────
POSTGRES_USER=analytics
POSTGRES_PASSWORD=analytics
POSTGRES_DB=analytics

# ── Analytics service overrides ───────────────────────────────────────────────
# Config file path (optional, defaults to configs/config.local.yaml)
# ANALYTICS_CONFIG_PATH=

# gRPC listen address
# ANALYTICS_GRPC_ADDR=:50054

# PostgreSQL DSN (required — no default)
ANALYTICS_DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable

# Movie catalog gRPC address
ANALYTICS_MOVIE_COLLECTION_ADDR=localhost:50052
# ANALYTICS_MOVIE_COLLECTION_TIMEOUT=3s

# Recommendation engine
# ANALYTICS_RECOMMENDATION_DEFAULT_LIMIT=10
# ANALYTICS_RECOMMENDATION_CANDIDATE_POOL_SIZE=100

# Graceful shutdown timeout
# ANALYTICS_SHUTDOWN_TIMEOUT=10s
